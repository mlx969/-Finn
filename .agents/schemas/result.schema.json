{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.agent-system/result.schema.json",
  "title": "Local Agent Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "request_id", "agent", "status", "started_at",
    "completed_at", "outcome", "changed_paths", "verification", "decisions",
    "residual_risks", "next_owner"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "request_id": {"type": "string"},
    "agent": {"type": "string", "minLength": 1},
    "status": {"enum": ["done", "failed", "blocked", "needs_review"]},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "outcome": {"type": "string", "minLength": 1},
    "changed_paths": {"type": "array", "items": {"type": "string"}},
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "status", "evidence"],
        "properties": {
          "command": {"type": "string"},
          "status": {"enum": ["pass", "fail", "not_run"]},
          "evidence": {"type": "string"}
        }
      }
    },
    "decisions": {"type": "array", "items": {"type": "string"}},
    "residual_risks": {"type": "array", "items": {"type": "string"}},
    "next_owner": {"type": "string", "minLength": 1}
  }
}

